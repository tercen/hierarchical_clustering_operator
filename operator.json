{
  "name": "Hierarchical Clustering",
  "description": "Clusters data points based on their pairwise similarity and returns the group memberships.",
  "tags": [
    "clustering"
  ],
  "authors": [
    "tercen"
  ],
  "urls": [
    "https://github.com/tercen/hierarchical_clustering_operator"
  ],
  "properties": [
    {
      "kind": "DoubleProperty",
      "name": "min_clust",
      "defaultValue": 1,
      "description": "Minimal number of clusters."
    },
    {
      "kind": "DoubleProperty",
      "name": "max_clust",
      "defaultValue": 10,
      "description": "Maximal number of clusters."
    }
  ],
  "operatorSpec": {
    "kind": "OperatorSpec",
    "ontologyUri": "https://tercen.com/_ontology/tercen",
    "ontologyVersion": "0.0.1",
    "inputSpecs": [
      {
        "kind": "CrosstabSpec",
        "metaFactors": [
          {
            "kind": "MetaFactor",
            "name": "Observations",
            "type": "",
            "description": "Observations to cluster.",
            "ontologyMapping": "observation",
            "crosstabMapping": "row",
            "cardinality": "1..n",
            "factors": []
          },
          {
            "kind": "MetaFactor",
            "name": "Variables",
            "type": "",
            "description": "Variables used to cluster observations.",
            "ontologyMapping": "variable",
            "crosstabMapping": "column",
            "cardinality": "1..n",
            "factors": []
          }
        ],
        "axis": [
          {
            "kind": "AxisSpec",
            "metaFactors": [
              {
                "kind": "MetaFactor",
                "name": "Measurement",
                "type": "numeric",
                "description": "Measurement values.",
                "ontologyMapping": "measurement",
                "crosstabMapping": "y",
                "cardinality": "1",
                "factors": []
              }
            ]
          }
        ]
      }
    ],
    "outputSpecsV2": [
      {
        "kind": "OperatorJoinSpec",
        "description": "Multi-resolution clustering output with order and cluster assignments per k value",
        "joinOperators": [
          {
            "kind": "JoinOperator",
            "joinType": "left",
            "leftPair": {
              "kind": "ColumnPair",
              "lColumns": [
                "Observations"
              ],
              "rColumns": [
                "Observations"
              ]
            },
            "rightRelation": {
              "kind": "TableRelation",
              "description": "Pivoted output with n_cluster and cluster columns",
              "attributes": [
                {
                  "kind": "Attribute",
                  "name": "r_order",
                  "type": "int32"
                },
                {
                  "kind": "Attribute",
                  "name": "n_cluster",
                  "type": "double"
                },
                {
                  "kind": "Attribute",
                  "name": "cluster",
                  "type": "int32"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}